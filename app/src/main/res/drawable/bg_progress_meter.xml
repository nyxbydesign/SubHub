<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/progress_meter_radius" />
            <solid android:color="@color/progress_track" />
            <stroke android:width="1dp" android:color="@color/progress_outline" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <!-- Keep drawable coordinates left-based; ProgressBar mirrors the Canvas for RTL.
             ScaleDrawable reads scaleGravity, not the generic gravity attribute. -->
        <scale android:scaleWidth="100%" android:scaleGravity="left">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/progress_meter_radius" />
                <solid android:color="@color/progress_fill" />
            </shape>
        </scale>
    </item>
</layer-list>
