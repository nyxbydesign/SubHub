<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow_soft" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#EB15111D"
                android:centerColor="#EE21172C" android:endColor="#EA2A1836" />
            <stroke android:width="1dp" android:color="@color/outline_default" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top"
        android:left="16dp" android:right="16dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#00F8EFFF"
                android:centerColor="@color/glass_highlight" android:endColor="#00F8EFFF" />
            <corners android:radius="1dp" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="bottom"
        android:bottom="1dp" android:left="18dp" android:right="18dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/accent_dim"
                android:endColor="@color/accent_hot_dim" />
            <corners android:bottomLeftRadius="18dp" android:bottomRightRadius="18dp" />
        </shape>
    </item>
</layer-list>
