<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="@color/nav_active_pressed" />
        <stroke android:width="2dp" android:color="@color/outline_focus" />
        <corners android:radius="10dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/nav_active_pressed" />
        <corners android:radius="10dp" /></shape></item>
    <item android:state_selected="true"><shape>
        <gradient android:angle="90" android:startColor="@color/control_checked_surface"
            android:endColor="@color/nav_pill" />
        <corners android:radius="10dp" /></shape></item>
    <item android:drawable="@android:color/transparent" />
</selector>
