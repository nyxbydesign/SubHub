<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="@color/surface_disabled"/><stroke android:width="1dp" android:color="@color/outline_subtle"/><corners android:radius="12dp"/></shape></item>
    <item android:state_checked="true"><shape><solid android:color="@color/control_checked_surface"/><stroke android:width="1dp" android:color="@color/control_checked_outline"/><corners android:radius="12dp"/></shape></item>
    <item><shape><solid android:color="@color/surface_card_raised"/><stroke android:width="1dp" android:color="@color/text_muted"/><corners android:radius="12dp"/></shape></item>
</selector>
