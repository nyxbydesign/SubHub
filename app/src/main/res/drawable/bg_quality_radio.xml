<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#CC111017" />
            <stroke android:width="1dp" android:color="#493C50" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/control_checked_surface"
                android:endColor="#2C2038" />
            <stroke android:width="2dp" android:color="@color/control_checked_outline" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/control_pressed_surface" />
            <stroke android:width="1dp" android:color="@color/control_focus" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#F10F0E15"
                android:endColor="#F21A1422" />
            <stroke android:width="1dp" android:color="#7041394D" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
