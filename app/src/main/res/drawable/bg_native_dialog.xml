<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle">
        <gradient android:angle="0" android:startColor="@color/dialog_surface_start"
            android:centerColor="@color/dialog_surface" android:endColor="@color/dialog_surface_end" />
        <stroke android:width="1dp" android:color="@color/outline_default" />
        <corners android:radius="24dp" />
    </shape></item>
    <item android:height="1dp" android:gravity="top" android:left="24dp" android:right="24dp">
        <shape><gradient android:angle="0" android:startColor="@android:color/transparent"
            android:centerColor="@color/glass_highlight" android:endColor="@android:color/transparent" /></shape>
    </item>
</layer-list>
