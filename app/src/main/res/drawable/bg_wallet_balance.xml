<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#F02D193D"
                android:centerColor="#F023172E" android:endColor="#F0100E18" />
            <stroke android:width="1dp" android:color="@color/outline_default" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top" android:left="22dp" android:right="22dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#009860BE"
                android:centerColor="#80C17AE1" android:endColor="#009860BE" />
        </shape>
    </item>
</layer-list>
