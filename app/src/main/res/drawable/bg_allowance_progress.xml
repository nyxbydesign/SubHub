<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="@color/surface_card_raised" />
            <stroke android:width="1dp" android:color="@color/outline_subtle" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <!-- Keep drawable coordinates left-based; ProgressBar mirrors the Canvas for RTL.
             ScaleDrawable reads scaleGravity, not the generic gravity attribute. -->
        <scale android:scaleWidth="100%" android:scaleGravity="left">
            <shape android:shape="rectangle">
                <corners android:radius="5dp" />
                <gradient android:angle="0" android:startColor="@color/accent_mid"
                    android:endColor="@color/accent_text" />
            </shape>
        </scale>
    </item>
</layer-list>
