<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow_soft" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/nav_pill"
                android:centerColor="#EE17111F" android:endColor="#EB100C16" />
            <stroke android:width="1dp" android:color="@color/nav_stroke" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top"
        android:left="24dp" android:right="24dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#00F8EFFF"
                android:centerColor="@color/glass_highlight" android:endColor="#00F8EFFF" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
