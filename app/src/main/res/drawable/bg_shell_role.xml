<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="@color/control_pressed_surface" />
        <stroke android:width="1dp" android:color="@color/accent_text" />
        <corners android:radius="12dp" /></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/control_checked_surface" />
        <stroke android:width="2dp" android:color="@color/outline_focus" />
        <corners android:radius="12dp" /></shape></item>
    <item><shape><solid android:color="@color/control_checked_surface" />
        <stroke android:width="1dp" android:color="@color/control_checked_outline" />
        <corners android:radius="12dp" /></shape></item>
</selector>
