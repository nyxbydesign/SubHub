<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Quiet plum replaces bright gradients. Fill remains above 3:1 against the
         track, outline, and surrounding card surfaces; labels retain text colors. -->
    <color name="progress_fill">#9B81B0</color>
    <color name="progress_track">@color/surface_card_raised</color>
    <color name="progress_outline">@color/outline_subtle</color>
    <dimen name="progress_meter_height">8dp</dimen>
    <dimen name="progress_meter_radius">4dp</dimen>
    <style name="Widget.SubHub.ProgressMeter" parent="@android:style/Widget.Material.ProgressBar.Horizontal">
        <item name="android:indeterminateOnly">false</item>
        <item name="android:progressDrawable">@drawable/bg_progress_meter</item>
        <item name="android:indeterminateTint">@color/progress_fill</item>
        <item name="android:progressTint">@null</item>
        <item name="android:progressBackgroundTint">@null</item>
        <item name="android:secondaryProgressTint">@null</item>
        <!-- Mirror once at draw time, including unchanged-size direction changes. -->
        <item name="android:mirrorForRtl">true</item>
        <item name="android:minHeight">@dimen/progress_meter_height</item>
        <item name="android:maxHeight">@dimen/progress_meter_height</item>
        <item name="android:padding">0dp</item>
    </style>
</resources>
