<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_main">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="@dimen/bottom_nav_clearance">
            <include layout="@layout/view_primary_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/page_margin" android:layout_marginTop="@dimen/primary_header_top" />
            <LinearLayout android:id="@+id/whispers_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/page_margin" android:layout_marginTop="@dimen/ui_gap_group" android:background="@drawable/bg_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:orientation="vertical" android:padding="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="@string/atmosphere_whispers_title" android:padding="0dp" android:src="@drawable/ic_subliminal_whisper_2" app:tint="@color/accent_mid" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/atmosphere_whispers_title" android:textColor="@color/text_primary" android:textSize="@dimen/ui_text_section" android:textStyle="bold" />
                        <TextView android:id="@+id/whispers_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_inline" android:textColor="@color/accent_text" android:textSize="@dimen/ui_text_caption" android:textStyle="bold" />
                    </LinearLayout>
                    <TextView android:id="@+id/button_whispers" android:layout_width="48dp" android:layout_height="48dp" android:minHeight="48dp" android:minWidth="48dp" android:text="" android:gravity="center" android:drawableEnd="@drawable/ic_wallet_chevron" android:paddingHorizontal="16dp" android:focusable="true" android:contentDescription="@string/atmosphere_shape_whispers" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/popup_storm_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/page_margin" android:layout_marginTop="@dimen/ui_gap_group" android:background="@drawable/bg_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:orientation="vertical" android:padding="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="@string/popup_title" android:padding="0dp" android:src="@drawable/ic_popup_storm" app:tint="@color/accent_hot" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/popup_title" android:textColor="@color/text_primary" android:textSize="@dimen/ui_text_section" android:textStyle="bold" />
                        <TextView android:id="@+id/popup_storm_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_gap_inline" android:textColor="@color/accent_hot" android:textSize="@dimen/ui_text_caption" android:textStyle="bold" />
                    </LinearLayout>
                    <TextView android:id="@+id/button_popup_storm" android:layout_width="48dp" android:layout_height="48dp" android:minHeight="48dp" android:minWidth="48dp" android:text="" android:gravity="center" android:drawableEnd="@drawable/ic_wallet_chevron" android:paddingHorizontal="16dp" android:focusable="true" android:contentDescription="@string/atmosphere_open_popup_storm" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_pill_nav" />
</FrameLayout>