<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/bottom_nav_clearance">

        <include
            layout="@layout/view_primary_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin"
            android:layout_marginTop="@dimen/primary_header_top" />

        <LinearLayout android:id="@+id/rituals_keyholder_card" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin" android:layout_marginTop="14dp"
            android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp"
            android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="42dp" android:layout_height="42dp" android:padding="9dp"
                    android:background="@drawable/bg_home_metric" android:src="@drawable/ic_keyholder"
                    app:tint="@color/accent_mid" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/keyholder_home_title" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                    <TextView android:id="@+id/rituals_keyholder_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/accent_mid" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp"
                android:text="@string/keyholder_intro_body" android:textSize="11sp" android:textColor="@color/text_secondary" />
            <TextView android:id="@+id/button_keyholder" style="@style/Widget.SubHub.OutlineAction"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                android:layout_marginTop="12dp" android:text="@string/keyholder_open" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/whispers_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_home_metric"
                    android:contentDescription="@string/atmosphere_whispers_title"
                    android:padding="9dp"
                    android:src="@drawable/ic_subliminal_whisper_2"
                    app:tint="@color/accent_mid" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/atmosphere_whispers_title"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/whispers_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/accent_mid"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.subhub.app.util.StateToggle
                    android:id="@+id/switch_whispers"
                    style="@style/Widget.SubHub.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:contentDescription="@string/atmosphere_whispers_toggle"
                    android:minWidth="52dp"
                    android:text="" />
            </LinearLayout>

            <TextView
                android:id="@+id/whispers_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/button_whispers"
                style="@style/Widget.SubHub.OutlineAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/atmosphere_shape_whispers" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/popup_storm_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_home_metric"
                    android:contentDescription="@string/popup_title"
                    android:padding="9dp"
                    android:src="@drawable/ic_popup_storm"
                    app:tint="@color/accent_hot" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/popup_title"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/popup_storm_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/accent_hot"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.subhub.app.util.StateToggle
                    android:id="@+id/switch_popup_storm"
                    style="@style/Widget.SubHub.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:contentDescription="@string/atmosphere_popup_toggle"
                    android:minWidth="52dp"
                    android:text="" />
            </LinearLayout>

            <TextView
                android:id="@+id/popup_storm_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/button_popup_storm"
                style="@style/Widget.SubHub.OutlineAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/atmosphere_open_popup_storm" />
        </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_pill_nav" />
</FrameLayout>
