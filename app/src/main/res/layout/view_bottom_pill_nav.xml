<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_navigation"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/bottom_nav_height"
    android:layout_marginHorizontal="@dimen/bottom_nav_margin"
    android:layout_marginBottom="@dimen/bottom_nav_bottom_margin"
    android:layout_gravity="bottom"
    android:background="@drawable/bg_bottom_pill"
    android:elevation="12dp"
    android:columnCount="4"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/nav_home"
        style="@style/Widget.SubHub.BottomTab"
        android:contentDescription="@string/nav_home">
        <ImageView
            android:id="@+id/nav_home_icon"
            style="@style/Widget.SubHub.BottomTabIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_tab_home" />
        <TextView
            android:id="@+id/nav_home_label"
            style="@style/Widget.SubHub.BottomTabLabel"
            android:text="@string/nav_home" />
    </LinearLayout>

    <LinearLayout android:id="@+id/nav_people" style="@style/Widget.SubHub.BottomTab" android:contentDescription="@string/role_people" android:visibility="gone">
        <ImageView android:id="@+id/nav_people_icon" style="@style/Widget.SubHub.BottomTabIcon" android:contentDescription="@null" android:src="@drawable/ic_nav_people" />
        <TextView android:id="@+id/nav_people_label" style="@style/Widget.SubHub.BottomTabLabel" android:text="@string/role_people" />
    </LinearLayout>
    <LinearLayout android:id="@+id/nav_activity" style="@style/Widget.SubHub.BottomTab"
        android:contentDescription="@string/dom_activity_title" android:visibility="gone">
        <FrameLayout android:layout_width="32dp" android:layout_height="24dp"
            android:importantForAccessibility="no">
            <ImageView android:id="@+id/nav_activity_icon" style="@style/Widget.SubHub.BottomTabIcon"
                android:layout_gravity="center" android:contentDescription="@null"
                android:src="@drawable/ic_shell_activity" />
            <View android:id="@+id/nav_activity_unread" android:layout_width="8dp"
                android:layout_height="8dp" android:layout_gravity="top|end"
                android:background="@drawable/bg_shell_unread" android:visibility="gone"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView android:id="@+id/nav_activity_label" style="@style/Widget.SubHub.BottomTabLabel"
            android:text="@string/dom_activity_title" />
    </LinearLayout>
    <LinearLayout android:id="@+id/nav_contract" style="@style/Widget.SubHub.BottomTab" android:contentDescription="@string/role_contract" android:visibility="gone">
        <ImageView android:id="@+id/nav_contract_icon" style="@style/Widget.SubHub.BottomTabIcon" android:contentDescription="@null" android:src="@drawable/ic_nav_contract" />
        <TextView android:id="@+id/nav_contract_label" style="@style/Widget.SubHub.BottomTabLabel" android:text="@string/role_contract" />
    </LinearLayout>
    <LinearLayout android:id="@+id/nav_stats" style="@style/Widget.SubHub.BottomTab" android:contentDescription="@string/role_stats" android:visibility="gone">
        <ImageView android:id="@+id/nav_stats_icon" style="@style/Widget.SubHub.BottomTabIcon" android:contentDescription="@null" android:src="@drawable/ic_nav_stats" />
        <TextView android:id="@+id/nav_stats_label" style="@style/Widget.SubHub.BottomTabLabel" android:text="@string/role_stats" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_censor"
        style="@style/Widget.SubHub.BottomTab"
        android:contentDescription="@string/nav_censor">
        <ImageView
            android:id="@+id/nav_censor_icon"
            style="@style/Widget.SubHub.BottomTabIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_nav_censor" />
        <TextView
            android:id="@+id/nav_censor_label"
            style="@style/Widget.SubHub.BottomTabLabel"
            android:text="@string/nav_censor" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_limits"
        style="@style/Widget.SubHub.BottomTab"
        android:contentDescription="@string/nav_limits">
        <ImageView
            android:id="@+id/nav_limits_icon"
            style="@style/Widget.SubHub.BottomTabIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_nav_limits" />
        <TextView
            android:id="@+id/nav_limits_label"
            style="@style/Widget.SubHub.BottomTabLabel"
            android:text="@string/nav_limits" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_money"
        style="@style/Widget.SubHub.BottomTab"
        android:contentDescription="@string/nav_money">
        <ImageView
            android:id="@+id/nav_money_icon"
            style="@style/Widget.SubHub.BottomTabIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_nav_money" />
        <TextView
            android:id="@+id/nav_money_label"
            style="@style/Widget.SubHub.BottomTabLabel"
            android:text="@string/nav_money" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_atmosphere"
        style="@style/Widget.SubHub.BottomTab"
        android:contentDescription="@string/nav_atmosphere">
        <ImageView
            android:id="@+id/nav_atmosphere_icon"
            style="@style/Widget.SubHub.BottomTabIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_atmosphere" />
        <TextView
            android:id="@+id/nav_atmosphere_label"
            style="@style/Widget.SubHub.BottomTabLabel"
            android:text="@string/nav_atmosphere" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_settings"
        style="@style/Widget.SubHub.BottomTab"
        android:contentDescription="@string/nav_settings">
        <ImageView
            android:id="@+id/nav_settings_icon"
            style="@style/Widget.SubHub.BottomTabIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_tab_settings" />
        <TextView
            android:id="@+id/nav_settings_label"
            style="@style/Widget.SubHub.BottomTabLabel"
            android:text="@string/nav_settings" />
    </LinearLayout>
</GridLayout>
