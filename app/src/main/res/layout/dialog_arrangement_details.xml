<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_native_dialog"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/arrangement_detail_icon" android:layout_width="32dp"
            android:layout_height="32dp" android:layout_marginEnd="12dp"
            app:tint="@color/accent_mid" android:importantForAccessibility="no" />
        <TextView android:id="@+id/arrangement_detail_title" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:includeFontPadding="false" android:accessibilityHeading="true"
            android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/arrangement_detail_body"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:clipToPadding="false" android:scrollbars="vertical">
        <LinearLayout android:id="@+id/arrangement_detail_rows" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/arrangement_detail_close"
        style="@style/Widget.SubHub.OutlineAction"
        android:layout_height="wrap_content" android:minHeight="@dimen/control_min_height"
        android:layout_marginTop="16dp"
        android:text="@string/close" />
</LinearLayout>
