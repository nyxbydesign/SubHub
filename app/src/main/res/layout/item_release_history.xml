<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/release_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/ui_gap_control"
    android:background="@drawable/bg_home_module"
    android:importantForAccessibility="no"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:id="@+id/release_item_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="@dimen/control_min_height"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/release_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/ui_text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/release_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_gap_inline"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/ui_text_caption" />
        </LinearLayout>

        <ImageView
            android:id="@+id/release_chevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_wallet_chevron"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <TextView
        android:id="@+id/release_details"
        style="@style/Widget.SubHub.FieldHelp"
        android:importantForAccessibility="yes"
        android:layout_marginTop="@dimen/ui_gap_control"
        android:paddingBottom="@dimen/ui_gap_inline"
        android:visibility="gone" />
</LinearLayout>
