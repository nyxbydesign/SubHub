<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/censor_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/page_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_margin"
            android:paddingTop="@dimen/primary_header_top"
            android:paddingEnd="@dimen/page_margin"
            android:paddingBottom="@dimen/bottom_nav_clearance">

            <include layout="@layout/view_primary_header" />

            <!-- One command deck: readiness, duration, and action. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_home_command"
                android:orientation="vertical"
                android:paddingStart="13dp"
                android:paddingTop="11dp"
                android:paddingEnd="13dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:id="@+id/onboarding_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_home_permission"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/onboarding_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/onboarding_help"
                            style="@style/Widget.SubHub.CompactAction"
                            android:text="@string/onboarding_help" />
                        <TextView android:id="@+id/onboarding_dismiss"
                            style="@style/Widget.SubHub.CompactAction"
                            android:layout_marginStart="8dp"
                            android:text="@string/onboarding_dismiss" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/permission_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_home_permission"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="9dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/home_permission_title"
                        android:padding="6dp"
                        android:src="@drawable/ic_tab_help"
                        app:tint="@color/accent_mid" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/home_permission_title"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/permission_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:includeFontPadding="false"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/permission_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_outline_button"
                        android:gravity="center"
                        android:minWidth="58dp"
                        android:paddingHorizontal="10dp"
                        android:text="@string/home_permission_action"
                        android:textColor="@color/accent_mid"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/commitment_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_home_module"
                    android:orientation="vertical"
                    android:padding="11dp">

                    <LinearLayout
                        android:id="@+id/commitment_start_panel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.13"
                                android:text="@string/commitment_timer_title"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:orientation="horizontal">
                            <TextView android:id="@+id/commitment_timer_1h" style="@style/Widget.SubHub.CompactAction" android:layout_height="wrap_content"
                                android:minHeight="48dp" android:text="@string/commitment_timer_1h" />
                            <TextView android:id="@+id/commitment_timer_24h" style="@style/Widget.SubHub.CompactAction" android:layout_height="wrap_content"
                                android:minHeight="48dp" android:layout_marginStart="8dp" android:text="@string/commitment_timer_24h" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">
                            <TextView android:id="@+id/commitment_timer_7d" style="@style/Widget.SubHub.CompactAction" android:layout_height="wrap_content"
                                android:minHeight="48dp" android:text="@string/commitment_timer_7d" />
                            <TextView android:id="@+id/commitment_timer_30d" style="@style/Widget.SubHub.CompactAction" android:layout_height="wrap_content"
                                android:minHeight="48dp" android:layout_marginStart="8dp" android:text="@string/commitment_timer_30d" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/commitment_timer_permanent"
                            style="@style/Widget.SubHub.OutlineAction"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_marginTop="8dp"
                            android:text="@string/commitment_timer_permanent" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/commitment_active_panel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_home_permission"
                        android:orientation="vertical"
                        android:padding="11dp"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/commitment_pact_sealed"
                            android:textColor="@color/accent_mid"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/commitment_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/button_commitment_view"
                            style="@style/Widget.SubHub.OutlineAction"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_marginTop="8dp"
                            android:text="@string/commitment_view_pact" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/button_protection"
                    style="@style/Widget.SubHub.ServiceButton"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_home_primary_action"
                    android:backgroundTint="@null"
                    android:elevation="0dp"
                    android:letterSpacing="0.11"
                    android:text="@string/start_protection"
                    android:textSize="13sp" />

                <LinearLayout android:id="@+id/protection_status_row" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
                    <View android:id="@+id/protection_status_dot" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_status_dot" />
                    <TextView android:id="@+id/protection_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/status_inactive" />
                </LinearLayout>
                <TextView android:id="@+id/runtime_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
                <TextView android:id="@+id/mode_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
            </LinearLayout>

            <LinearLayout android:id="@+id/keyholder_intro" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:background="@drawable/bg_sub_hero" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/keyholder_intro_title"
                    android:textColor="@color/accent_hot" android:textStyle="bold" android:textSize="14sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:text="@string/keyholder_intro_body" android:textColor="@color/text_secondary" android:textSize="12sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp">
                    <TextView android:id="@+id/keyholder_intro_open" style="@style/Widget.SubHub.CompactAction" android:text="@string/keyholder_intro_open" />
                    <TextView android:id="@+id/keyholder_intro_dismiss" style="@style/Widget.SubHub.CompactAction" android:layout_marginStart="8dp" android:text="@string/keyholder_intro_dismiss" />
                </LinearLayout>
            </LinearLayout>

            <!-- Arrangement: a quiet, ordered summary of every enabled module. -->
            <LinearLayout
                android:id="@+id/sub_dashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_primary_content_gap"
                android:background="@drawable/bg_home_dashboard"
                android:orientation="vertical"
                android:padding="13dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.13"
                        android:text="@string/home_arrangement_title"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/home_arrangement_hint"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/sub_censor_card"
                        android:layout_width="0dp"
                        android:layout_height="88dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_module"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="9dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_home_metric"
                            android:contentDescription="@string/sub_censor_title"
                            android:padding="7dp"
                            android:src="@drawable/ic_nav_censor"
                            app:tint="@color/accent_mid" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/sub_censor_title"
                            android:visibility="gone"
                            android:textColor="@color/text_secondary"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/sub_censor_voice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:autoSizeMaxTextSize="10sp"
                            android:autoSizeMinTextSize="7sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/sub_censor_summary"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:autoSizeMaxTextSize="8sp"
                            android:autoSizeMinTextSize="6sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:textColor="@color/text_muted"
                            android:textSize="8sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/sub_limits_card"
                        android:layout_width="0dp"
                        android:layout_height="88dp"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_module"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="9dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_home_metric"
                            android:contentDescription="@string/sub_limits_title"
                            android:padding="7dp"
                            android:src="@drawable/ic_nav_limits"
                            app:tint="@color/accent_mid" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/sub_limits_title"
                            android:visibility="gone"
                            android:textColor="@color/text_secondary"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/sub_limits_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:autoSizeMaxTextSize="10sp"
                            android:autoSizeMinTextSize="7sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="2"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/sub_limits_detail"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:autoSizeMaxTextSize="8sp"
                            android:autoSizeMinTextSize="6sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:textColor="@color/text_muted"
                            android:textSize="8sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/sub_wallet_card"
                        android:layout_width="0dp"
                        android:layout_height="88dp"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_module"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="9dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_home_metric"
                            android:contentDescription="@string/sub_wallet_title"
                            android:padding="7dp"
                            android:src="@drawable/ic_nav_money"
                            app:tint="@color/accent_mid" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/sub_wallet_title"
                            android:visibility="gone"
                            android:textColor="@color/text_secondary"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/sub_wallet_voice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:autoSizeMaxTextSize="10sp"
                            android:autoSizeMinTextSize="7sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="2"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/sub_wallet_summary"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:autoSizeMaxTextSize="8sp"
                            android:autoSizeMinTextSize="6sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:textColor="@color/text_muted"
                            android:textSize="8sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/sub_atmosphere_card"
                        android:layout_width="0dp"
                        android:layout_height="88dp"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_module"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="9dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_home_metric"
                            android:contentDescription="@string/atmosphere_title"
                            android:padding="7dp"
                            android:src="@drawable/ic_atmosphere"
                            app:tint="@color/accent_mid" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/atmosphere_title"
                            android:visibility="gone"
                            android:textColor="@color/text_secondary"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/sub_atmosphere_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:autoSizeMaxTextSize="10sp"
                            android:autoSizeMinTextSize="7sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="2"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/sub_atmosphere_summary"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:autoSizeMaxTextSize="8sp"
                            android:autoSizeMinTextSize="6sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:textColor="@color/text_muted"
                            android:textSize="8sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/sub_wallet_pay"
                    style="@style/Widget.SubHub.OutlineAction"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="7dp"
                    android:text="@string/sub_wallet_pay"
                    android:textColor="@color/accent_mid"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/sub_wallet_pause"
                    style="@style/Widget.SubHub.OutlineAction"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/accent_mid"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/sub_modules_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_home_module"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sub_dashboard_empty_title"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/sub_dashboard_empty_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Journey: live service, milestones, and lifetime progress as one story. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_primary_content_gap"
                android:background="@drawable/bg_home_dashboard"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:letterSpacing="0.13" android:visibility="gone" android:text="@string/home_journey_title" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/home_session_metrics" android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/button_statistics" android:visibility="gone"
                    style="@style/Widget.SubHub.OutlineAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/statistics_view" />

                <LinearLayout android:id="@+id/home_lifetime_stats" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/home_lifetime_title" android:textColor="@color/text_secondary" android:textSize="10sp" android:textStyle="bold" />
                    <LinearLayout
                        android:id="@+id/home_lifetime_metrics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout android:id="@+id/achievements_home_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_home_module" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:orientation="vertical" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:letterSpacing="0.12" android:text="@string/achievements_home_title" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/achievements_home_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_achievement_tag" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:textColor="@color/accent_hot" android:textSize="10sp" android:textStyle="bold" />
                    </LinearLayout>
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="116dp" android:layout_marginTop="9dp" android:clipToPadding="false" android:scrollbars="none">
                        <LinearLayout android:id="@+id/achievements_home_badges" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" />
                    </HorizontalScrollView>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/achievements_home_next" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/text_primary" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:id="@+id/achievements_home_progress_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="@color/accent_hot" android:textSize="10sp" android:textStyle="bold" />
                    </LinearLayout>
                    <ProgressBar android:id="@+id/achievements_home_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="7dp" android:max="100" android:progressBackgroundTint="@color/outline_subtle" android:progressTint="@color/accent_hot" />
                    <TextView android:id="@+id/button_achievements" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:layout_marginTop="7dp" android:gravity="center_vertical" android:text="@string/achievements_home_action" android:textColor="@color/accent_mid" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Settings are in their own tabs; these hidden views retain controller bindings. -->
            <LinearLayout android:id="@+id/dom_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/button_accessibility_capture" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/button_censor_settings" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/button_export" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <LinearLayout android:id="@+id/penance_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:id="@+id/penance_status" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/button_penance_view" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_pill_nav" />
</FrameLayout>
