<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_main">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingTop="@dimen/primary_header_top"
        android:paddingStart="@dimen/page_margin" android:paddingEnd="@dimen/page_margin">
        <include layout="@layout/view_primary_header" />
        <LinearLayout android:id="@+id/people_section_container" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <FrameLayout android:id="@+id/people_panes" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1">
            <ScrollView android:id="@+id/people_roster_scroll" android:layout_width="match_parent"
                android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
                <LinearLayout android:id="@+id/role_page_body" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:paddingTop="20dp" android:paddingBottom="@dimen/bottom_nav_clearance" />
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
    <include layout="@layout/view_bottom_pill_nav" />
</FrameLayout>
