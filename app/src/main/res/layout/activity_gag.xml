<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/gag_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_margin"
        android:paddingTop="@dimen/primary_header_top"
        android:paddingBottom="@dimen/page_margin">

        <include layout="@layout/view_primary_header" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_gap_group"
            android:text="@string/gag_description"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/gag_keyboard_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_gap_control"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/accent_text" />

        <include
            android:id="@+id/gag_keyboard_settings"
            layout="@layout/view_ux_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_gap_control" />

        <include
            android:id="@+id/gag_keyboard_picker"
            layout="@layout/view_ux_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_gap_inline" />

        <include
            android:id="@+id/gag_enabled"
            layout="@layout/view_form_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_gap_group" />

        <RadioGroup
            android:id="@+id/gag_modes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioButton
                android:id="@+id/gag_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gag_every_word" />
            <RadioButton
                android:id="@+id/gag_every_n"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gag_every_n_words" />
            <RadioButton
                android:id="@+id/gag_specific"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gag_specific_words" />
        </RadioGroup>

        <EditText
            android:id="@+id/gag_interval"
            style="@style/Widget.SubHub.Input"
            android:hint="@string/gag_interval"
            android:inputType="number"
            android:maxLength="3" />

        <EditText
            android:id="@+id/gag_words"
            style="@style/Widget.SubHub.Input"
            android:hint="@string/gag_words"
            android:inputType="textMultiLine"
            android:maxLength="2048"
            android:maxLines="6"
            android:minLines="2" />

        <EditText
            android:id="@+id/gag_replacements"
            style="@style/Widget.SubHub.Input"
            android:hint="@string/gag_replacements"
            android:inputType="textMultiLine"
            android:maxLength="2048"
            android:maxLines="6"
            android:minLines="2" />

        <include
            android:id="@+id/gag_save"
            layout="@layout/view_ux_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_gap_control" />

        <TextView
            android:id="@+id/gag_save_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</ScrollView>
