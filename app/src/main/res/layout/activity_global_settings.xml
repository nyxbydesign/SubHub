<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/settings_sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_margin"
            android:paddingTop="10dp"
            android:paddingEnd="@dimen/page_margin"
            android:paddingBottom="116dp">

            <LinearLayout
                android:id="@+id/settings_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="9dp"
                android:background="@drawable/bg_header_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_header_icon"
                    android:contentDescription="@string/nav_settings"
                    android:padding="9dp"
                    android:src="@drawable/ic_tab_settings"
                    app:tint="@color/accent" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/settings_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="@string/global_settings_title"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/global_settings_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/button_edit_lock"
                    style="@style/Widget.SubHub.ControllerEdit"
                    android:text="@string/controller_edit_locked" />
            </LinearLayout>

            <TextView
                android:id="@+id/settings_group_protection"
                style="@style/Widget.SubHub.SettingsGroupLabel"
                android:layout_marginTop="@dimen/settings_first_group_gap"
                android:layout_marginBottom="@dimen/settings_group_label_gap"
                android:text="@string/global_settings_group_protection" />

            <LinearLayout
                android:id="@+id/hardcore_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sub_hero"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">
                <TextView style="@style/Widget.SubHub.SectionHeader"
                    android:text="@string/hardcore_title" />
                <TextView style="@style/Widget.SubHub.FieldHelp"
                    android:layout_marginTop="4dp"
                    android:text="@string/hardcore_body" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_hardcore_mode"
                    style="@style/Widget.SubHub.SettingsToggle"
                    android:layout_width="match_parent"
                    android:layout_marginTop="5dp"
                    android:text="@string/hardcore_toggle" />
                <TextView
                    android:id="@+id/hardcore_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/hardcore_status_off"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/button_hardcore_system"
                    style="@style/Widget.SubHub.OutlineAction"
                    android:layout_height="42dp"
                    android:layout_marginTop="9dp"
                    android:text="@string/hardcore_open_admin"
                    />
                <TextView
                    android:id="@+id/button_hardcore_restricted"
                    style="@style/Widget.SubHub.OutlineAction"
                    android:layout_height="42dp"
                    android:layout_marginTop="7dp"
                    android:text="@string/hardcore_open_restricted"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/feature_areas_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/settings_card_gap"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView style="@style/Widget.SubHub.SectionHeader"
                    android:text="@string/global_features_title" />
                <TextView style="@style/Widget.SubHub.FieldHelp"
                    android:layout_marginTop="3dp"
                    android:text="@string/global_features_help" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_module_censor"
                    style="@style/Widget.SubHub.SettingsToggle"
                    android:layout_width="match_parent"
                    android:text="@string/global_feature_censor" />
                <TextView style="@style/Widget.SubHub.FieldHelp"
                    android:text="@string/global_feature_censor_help" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_module_limits"
                    style="@style/Widget.SubHub.SettingsToggle"
                    android:layout_width="match_parent"
                    android:text="@string/global_feature_limits" />
                <TextView style="@style/Widget.SubHub.FieldHelp"
                    android:text="@string/global_feature_limits_help" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_module_wallet"
                    style="@style/Widget.SubHub.SettingsToggle"
                    android:layout_width="match_parent"
                    android:text="@string/global_feature_wallet" />
                <TextView style="@style/Widget.SubHub.FieldHelp"
                    android:text="@string/global_feature_wallet_help" />
            </LinearLayout>

            <TextView
                android:id="@+id/settings_group_coverage"
                style="@style/Widget.SubHub.SettingsGroupLabel"
                android:layout_marginTop="@dimen/settings_group_gap"
                android:layout_marginBottom="@dimen/settings_group_label_gap"
                android:text="@string/global_settings_group_coverage" />

            <LinearLayout
                android:id="@+id/android_access_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView style="@style/Widget.SubHub.SectionHeader"
                    android:text="@string/app_mode_service_title" />
                <TextView
                    android:id="@+id/service_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView style="@style/Widget.SubHub.FieldHelp"
                    android:layout_marginTop="3dp"
                    android:text="@string/app_mode_service_body" />
                <Button
                    android:id="@+id/button_accessibility_settings"
                    style="@style/Widget.SubHub.PrimaryButton"
                    android:layout_marginTop="8dp"
                    android:text="@string/app_mode_open_accessibility" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/recognition_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView style="@style/Widget.SubHub.SectionHeader"
                    android:text="@string/app_mode_rules_title" />
                <CheckBox
                    android:id="@+id/armed"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:buttonTint="@color/accent"
                    android:text="@string/app_mode_armed"
                    android:visibility="gone"
                    android:textColor="@color/text_primary" />
                <RadioGroup
                    android:id="@+id/mode_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <RadioButton
                        android:id="@+id/mode_always"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:buttonTint="@color/accent"
                        android:text="@string/app_mode_always"
                        android:textColor="@color/text_primary" />
                    <RadioButton
                        android:id="@+id/mode_selected"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:buttonTint="@color/accent"
                        android:text="@string/app_mode_selected"
                        android:textColor="@color/text_primary" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/app_list_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView style="@style/Widget.SubHub.SectionHeader"
                    android:text="@string/app_selection_title" />
                <TextView style="@style/Widget.SubHub.FieldHelp"
                    android:layout_marginTop="3dp"
                    android:text="@string/app_selection_help" />
                <TextView
                    android:id="@+id/selected_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/button_toggle_apps"
                    style="@style/Widget.SubHub.CompactOutlineButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:text="@string/app_selection_expand" />
                <LinearLayout
                    android:id="@+id/app_list_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <ProgressBar
                        android:id="@+id/loading_apps"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="14dp" />
                    <GridLayout
                        android:id="@+id/app_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:alignmentMode="alignMargins"
                        android:columnCount="@integer/app_picker_columns"
                        android:orientation="horizontal" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/settings_group_services"
                style="@style/Widget.SubHub.SettingsGroupLabel"
                android:layout_marginTop="@dimen/settings_group_gap"
                android:layout_marginBottom="@dimen/settings_group_label_gap"
                android:text="@string/global_settings_group_services" />

            <LinearLayout
                android:id="@+id/app_settings_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:id="@+id/app_settings_title"
                    style="@style/Widget.SubHub.SectionHeader"
                    android:text="@string/global_app_settings_title" />
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:columnCount="1">
                    <TextView android:id="@+id/button_profiles"
                        style="@style/Widget.SubHub.SettingsAction"
                        android:text="@string/global_arrangement_studio" />
                    <TextView android:id="@+id/button_diagnostics"
                        style="@style/Widget.SubHub.SettingsAction"
                        android:text="@string/global_diagnostics" />
                    <TextView android:id="@+id/button_commitment"
                        style="@style/Widget.SubHub.SettingsAction"
                        android:text="@string/global_security" />
                </GridLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/paypal_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/settings_card_gap"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView style="@style/Widget.SubHub.SectionHeader"
                    android:text="@string/paypal_settings_title" />
                <TextView style="@style/Widget.SubHub.FieldHelp"
                    android:layout_marginTop="3dp"
                    android:text="@string/paypal_settings_help" />
                <TextView style="@style/Widget.SubHub.FieldLabel"
                    android:text="@string/paypal_environment_label" />
                <RadioGroup
                    android:id="@+id/paypal_environment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton
                        android:id="@+id/paypal_environment_sandbox"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="@string/paypal_environment_sandbox"
                        android:textColor="@color/text_primary" />
                    <RadioButton
                        android:id="@+id/paypal_environment_live"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="@string/paypal_environment_live"
                        android:textColor="@color/text_primary" />
                </RadioGroup>
                <TextView style="@style/Widget.SubHub.FieldHelp"
                    android:text="@string/paypal_environment_help" />
                <TextView
                    android:id="@+id/paypal_sandbox_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:textColor="@color/accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView style="@style/Widget.SubHub.FieldLabel"
                    android:text="@string/wallet_currency_label" />
                <RadioGroup
                    android:id="@+id/wallet_currency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton android:id="@+id/wallet_currency_eur"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:minHeight="48dp"
                        android:text="@string/wallet_currency_eur" />
                    <RadioButton android:id="@+id/wallet_currency_usd"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:minHeight="48dp"
                        android:text="@string/wallet_currency_usd" />
                </RadioGroup>
                <TextView android:id="@+id/wallet_currency_status"
                    style="@style/Widget.SubHub.FieldHelp"
                    android:text="@string/wallet_currency_help" />
                <Button android:id="@+id/button_refresh_wallet_currency"
                    style="@style/Widget.SubHub.CompactOutlineButton"
                    android:layout_width="match_parent"
                    android:text="@string/wallet_currency_refresh" />
                <TextView android:labelFor="@id/paypal_client_id" style="@style/Widget.SubHub.FieldLabel"
                    android:text="@string/paypal_client_id_label" />
                <EditText
                    android:id="@+id/paypal_client_id"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="3dp"
                    android:backgroundTint="@color/accent"
                    android:hint="@string/paypal_client_id_hint"
                    android:inputType="textNoSuggestions"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted" />
                <TextView style="@style/Widget.SubHub.FieldLabel"
                    android:text="@string/paypal_client_secret_label" />
                <TextView style="@style/Widget.SubHub.FieldHelp"
                    android:text="@string/paypal_client_secret_help" />
                <EditText
                    android:id="@+id/paypal_client_secret"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="3dp"
                    android:backgroundTint="@color/accent"
                    android:hint="@string/paypal_client_secret_hint"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/button_save_paypal_sandbox"
                        style="@style/Widget.SubHub.CompactOutlineButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:text="@string/paypal_sandbox_save" />
                    <Button
                        android:id="@+id/button_clear_paypal_sandbox"
                        style="@style/Widget.SubHub.CompactOutlineButton"
                        android:layout_width="0dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:text="@string/paypal_sandbox_clear" />
                </LinearLayout>
                <TextView style="@style/Widget.SubHub.FieldHelp"
                    android:layout_marginTop="8dp"
                    android:text="@string/paypal_vault_help" />
                <TextView
                    android:id="@+id/paypal_vault_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/button_link_paypal_wallet"
                    style="@style/Widget.SubHub.CompactOutlineButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="7dp"
                    android:text="@string/paypal_wallet_link" />
                <CheckBox
                    android:id="@+id/paypal_auto_pay_enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="42dp"
                    android:text="@string/paypal_auto_pay_enable"
                    android:textColor="@color/text_primary" />
                <TextView style="@style/Widget.SubHub.FieldHelp"
                    android:text="@string/paypal_auto_pay_help" />
                <TextView
                    android:id="@+id/paypal_auto_pay_status"
                    style="@style/Widget.SubHub.FieldHelp"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/accent_hot"
                    android:visibility="gone" />
                <TextView style="@style/Widget.SubHub.FieldHelp"
                    android:layout_marginTop="8dp"
                    android:text="@string/paypal_link_help" />
                <TextView style="@style/Widget.SubHub.FieldLabel"
                    android:text="@string/paypal_link_label" />
                <EditText
                    android:id="@+id/paypal_link"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="3dp"
                    android:backgroundTint="@color/accent"
                    android:hint="@string/paypal_link_hint"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted" />
                <Button
                    android:id="@+id/button_save_paypal"
                    style="@style/Widget.SubHub.PrimaryButton"
                    android:layout_marginTop="8dp"
                    android:text="@string/paypal_settings_save" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_pill_nav" />
</FrameLayout>
