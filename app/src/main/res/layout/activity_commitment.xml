<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <include layout="@layout/view_secondary_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin"
            android:layout_marginTop="@dimen/primary_header_top" />

        <LinearLayout
            android:id="@+id/inactive_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">
            <com.subhub.app.commitment.ServiceDurationView
                android:id="@+id/duration_selection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <Button android:id="@+id/duration_open_home"
                style="@style/Widget.SubHub.CompactOutlineButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/tour_open_home" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/active_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView style="@style/Widget.SubHub.SectionHeader" android:text="@string/commitment_pact_sealed" />

            <TextView
                android:id="@+id/countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/commitment_active_body"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/button_emergency_release"
                style="@style/Widget.SubHub.DangerAction"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/commitment_emergency_release"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
