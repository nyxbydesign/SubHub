<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_mode_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@drawable/bg_main">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipToPadding="false" android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/bottom_nav_clearance">

        <include
            layout="@layout/view_primary_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_margin"
            android:layout_marginTop="@dimen/primary_header_top" />

        <LinearLayout android:id="@+id/timer_card" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/page_margin"
            android:layout_marginTop="8dp" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="11dp">
            <TextView style="@style/Widget.SubHub.SectionHeader"
                android:text="@string/app_timer_title" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/app_timer_body"
                android:textColor="@color/text_secondary" android:textSize="11sp" />

            <CheckBox android:id="@+id/per_app_limit_enabled" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" android:layout_marginTop="8dp"
                android:buttonTint="@color/toggle_tint" android:text="@string/app_timer_per_app"
                android:textColor="@color/text_primary" />
            <TextView style="@style/Widget.SubHub.FieldHelp"
                android:text="@string/app_timer_per_app_allowances_help" />
            <LinearLayout android:id="@+id/default_allowance_group"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:labelFor="@id/default_limit_minutes"
                    style="@style/Widget.SubHub.FieldLabel" android:text="@string/app_timer_default_minutes" />
                <EditText android:id="@+id/default_limit_minutes" style="@style/Widget.SubHub.Input"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:inputType="number" android:maxLength="4" />
            </LinearLayout>
            <LinearLayout android:id="@+id/per_app_allowances_list"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:orientation="vertical" />

            <CheckBox android:id="@+id/total_limit_enabled" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" android:layout_marginTop="8dp"
                android:buttonTint="@color/toggle_tint" android:text="@string/app_timer_combined"
                android:textColor="@color/text_primary" />
            <TextView android:labelFor="@id/total_limit_minutes" style="@style/Widget.SubHub.FieldLabel"
                android:text="@string/app_timer_total_minutes_label" />
            <TextView style="@style/Widget.SubHub.FieldHelp"
                android:text="@string/app_timer_total_minutes_help" />
            <EditText style="@style/Widget.SubHub.Input" android:id="@+id/total_limit_minutes" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" android:layout_marginTop="4dp"
                android:hint="@string/app_timer_minutes_hint" android:inputType="number"
                android:maxLength="4" android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted" />
            <TextView android:id="@+id/timer_usage_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
<include layout="@layout/view_bottom_pill_nav" />
</FrameLayout>
