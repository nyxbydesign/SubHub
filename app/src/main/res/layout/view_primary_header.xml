<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/primary_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/primary_header_height"
    android:background="@drawable/bg_header_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/button_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/control_min_height"
        android:minHeight="@dimen/control_min_height"
        android:gravity="center"
        android:text="@string/back"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/primary_header_icon"
        android:layout_width="@dimen/primary_header_icon_size"
        android:layout_height="@dimen/primary_header_icon_size"
        android:background="@drawable/bg_header_icon"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:padding="10dp"
        app:tint="@color/text_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/primary_header_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
        android:id="@+id/primary_header_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/button_edit_lock"
        style="@style/Widget.SubHub.ControllerEdit"
        android:layout_marginStart="8dp"
        android:text="@string/controller_edit_locked" />
</LinearLayout>
