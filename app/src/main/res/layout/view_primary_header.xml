<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/primary_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/primary_header_height"
    android:background="@drawable/bg_primary_header_rule"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="0dp"
    android:paddingTop="@dimen/ui_gap_control"
    android:paddingEnd="0dp"
    android:paddingBottom="@dimen/ui_gap_control">

    <TextView
        android:id="@+id/button_back"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/control_min_height"
        android:minHeight="@dimen/control_min_height"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/back"
        android:textColor="@color/accent_text"
        android:textSize="@dimen/ui_text_label"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/primary_header_icon"
        android:layout_width="@dimen/primary_header_icon_size"
        android:layout_height="@dimen/primary_header_icon_size"
        android:background="@drawable/bg_header_icon"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:padding="@dimen/ui_tile_padding"
        app:tint="@color/text_primary" />

    <LinearLayout
        android:id="@+id/primary_header_copy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/primary_header_brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:importantForAccessibility="no"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/ui_text_label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/primary_header_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.0"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/ui_text_title"
            android:textStyle="bold" />

        <TextView
        android:id="@+id/primary_header_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_gap_inline"
            android:includeFontPadding="false"
            android:textColor="@color/text_secondary"
        android:textSize="@dimen/ui_text_label"
        android:visibility="gone" />
    </LinearLayout>

    <TextView android:id="@+id/header_role_badge"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:background="@drawable/bg_role_badge"
        android:includeFontPadding="false" android:textColor="@color/accent_text"
        android:textSize="11sp" android:textStyle="bold" android:text="@string/role_sub"
        android:visibility="gone" />

    <TextView
        android:id="@+id/button_edit_lock"
        style="@style/Widget.SubHub.ControllerEdit"
        android:layout_marginStart="8dp"
        android:minWidth="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_shell_role"
        android:elevation="0dp"
        android:singleLine="false"
        android:ellipsize="none"
        android:text="@string/controller_edit_locked" />
</LinearLayout>
